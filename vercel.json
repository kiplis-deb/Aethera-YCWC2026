{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "Frontend",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    }
  ]
}
