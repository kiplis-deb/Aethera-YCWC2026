# ==============================================================================
# AETHERA ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure in your cloud host's environment settings
# ==============================================================================

# 1. Google Gemini AI Key (Required for AI Studio, Chatbot, and Assistant)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase PostgreSQL (Required for persistent Cloud Database & Vercel deployment)
# Get these free from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: Supabase Anon Key (Fallback if service role key is not provided)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. Server Port (Default is 3000, cloud providers automatically set this)
PORT=3000
